"use client";
import React, { useState, useEffect } from "react";
import { createClient } from "@supabase/supabase-js";
import jsPDF from "jspdf";
import autoTable from "jspdf-autotable";
import {
  Package,
  FileText,
  Wallet,
  Plus,
  Download,
  RefreshCw,
} from "lucide-react";

const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || "";
const supabaseKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || "";
const supabase =
  supabaseUrl && supabaseKey ? createClient(supabaseUrl, supabaseKey) : null;

export default function InventoryOfficeApp() {
  const [role, setRole] = useState("admin");
  const [activeTab, setActiveTab] = useState("inventory");
  const [products, setProducts] = useState([]);
  const [expenses, setExpenses] = useState([]);
  const [loading, setLoading] = useState(false);

  const [newItem, setNewItem] = useState({
    name: "",
    sku: "",
    cost_price: "",
    sale_price: "",
    current_stock: "",
  });

  const [newExpense, setNewExpense] = useState({
    title: "",
    category: "Office",
    amount: "",
  });

  const fetchData = async () => {
    if (!supabase) return;
    setLoading(true);
    const { data: prodData } = await supabase
      .from("products")
      .select("*")
      .order("id", { ascending: true });
    if (prodData) setProducts(prodData);

    const { data: expData } = await supabase
      .from("office_expenses")
      .select("*")
      .order("id", { ascending: false });
    if (expData) setExpenses(expData);
    setLoading(false);
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleAddProduct = async (e) => {
    e.preventDefault();
    if (!supabase || !newItem.name) return;
    const { error } = await supabase.from("products").insert([
      {
        name: newItem.name,
        sku: newItem.sku || `SKU-${Date.now().toString().slice(-4)}`,
        cost_price: Number(newItem.cost_price) || 0,
        sale_price: Number(newItem.sale_price) || 0,
        current_stock: Number(newItem.current_stock) || 0,
      },
    ]);
    if (!error) {
      setNewItem({
        name: "",
        sku: "",
        cost_price: "",
        sale_price: "",
        current_stock: "",
      });
      fetchData();
    } else {
      alert("Error: " + error.message);
    }
  };

  const handleUpdateStock = async (product, change) => {
    if (!supabase) return;
    const updatedQty = Math.max(0, (product.current_stock || 0) + change);
    await supabase
      .from("products")
      .update({ current_stock: updatedQty })
      .eq("id", product.id);

    await supabase.from("stock_transactions").insert([
      {
        product_id: product.id,
        type: change > 0 ? "IN" : "OUT",
        quantity: Math.abs(change),
        notes: `Updated by ${role}`,
      },
    ]);
    fetchData();
  };

  const handleAddExpense = async (e) => {
    e.preventDefault();
    if (!supabase || !newExpense.title || !newExpense.amount) return;
    const { error } = await supabase.from("office_expenses").insert([
      {
        title: newExpense.title,
        category: newExpense.category,
        amount: Number(newExpense.amount),
      },
    ]);
    if (!error) {
      setNewExpense({ title: "", category: "Office", amount: "" });
      fetchData();
    } else {
      alert("Error: " + error.message);
    }
  };

  const downloadPDF = () => {
    const doc = new jsPDF();
    doc.setFontSize(18);
    doc.text("Office & Inventory Report", 14, 20);
    doc.setFontSize(10);
    doc.text(
      `Role: ${role.toUpperCase()} | Date: ${new Date().toLocaleDateString()}`,
      14,
      28
    );

    if (activeTab === "expenses" && (role === "admin" || role === "staff")) {
      const rows = expenses.map((ex) => [
        ex.expense_date || "-",
        ex.title,
        ex.category,
        `Rs. ${ex.amount}`,
      ]);
      autoTable(doc, {
        startY: 35,
        head: [["Date", "Expense Title", "Category", "Amount"]],
        body: rows,
      });
      doc.save("Office_Expenses_Report.pdf");
    } else {
      const rows = products.map((p) => [
        p.sku || "-",
        p.name,
        `${p.current_stock} Units`,
        role === "worker" ? "Hidden" : `Rs. ${p.sale_price}`,
        role === "worker"
          ? "Hidden"
          : `Rs. ${(p.current_stock || 0) * (p.sale_price || 0)}`,
      ]);
      autoTable(doc, {
        startY: 35,
        head: [["SKU", "Item Name", "Stock", "Sale Price", "Total Value"]],
        body: rows,
      });
      doc.save(`Inventory_Report_${role}.pdf`);
    }
  };

  const totalStockValue = products.reduce(
    (sum, p) => sum + (p.current_stock || 0) * (p.sale_price || 0),
    0
  );
  const totalExpenses = expenses.reduce(
    (sum, ex) => sum + Number(ex.amount || 0),
    0
  );

  return (
    <div className="min-h-screen bg-slate-100 flex flex-col md:flex-row">
      {/* Desktop Sidebar */}
      <aside className="hidden md:flex md:w-64 bg-slate-900 text-white flex-col p-5 space-y-6">
        <h1 className="text-xl font-bold border-b border-slate-700 pb-4">
          Office & Stock Pro
        </h1>
        <nav className="space-y-2 flex-1">
          <button
            onClick={() => setActiveTab("inventory")}
            className={`w-full flex items-center gap-3 p-3 rounded-lg font-medium ${
              activeTab === "inventory"
                ? "bg-blue-600 text-white"
                : "text-slate-300 hover:bg-slate-800"
            }`}
          >
            <Package size={20} /> Inventory & Stock
          </button>

          {(role === "admin" || role === "staff") && (
            <button
              onClick={() => setActiveTab("expenses")}
              className={`w-full flex items-center gap-3 p-3 rounded-lg font-medium ${
                activeTab === "expenses"
                  ? "bg-blue-600 text-white"
                  : "text-slate-300 hover:bg-slate-800"
              }`}
            >
              <Wallet size={20} /> Office Expenses
            </button>
          )}
        </nav>
      </aside>

      {/* Main Content */}
      <main className="flex-1 p-4 md:p-8 pb-24">
        {!supabase && (
          <div className="bg-amber-100 border-l-4 border-amber-500 text-amber-900 p-4 rounded-lg mb-4 text-sm">
            <strong>Database Connect Karna Baqi Hai:</strong> Vercel settings
            mein apni Supabase URL aur Key add karein taake data save ho sake.
          </div>
        )}

        {/* Header & Role Switcher */}
        <div className="bg-white p-4 rounded-xl shadow-sm mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div className="flex items-center gap-3">
            <div>
              <h2 className="text-xl font-bold text-slate-800 capitalize">
                {role} Dashboard
              </h2>
              <p className="text-xs text-slate-500">
                Live Mobile + Desktop System
              </p>
            </div>
            <button
              onClick={fetchData}
              className="p-2 bg-slate-100 rounded-lg hover:bg-slate-200"
              title="Refresh Data"
            >
              <RefreshCw
                size={16}
                className={loading ? "animate-spin text-blue-600" : ""}
              />
            </button>
          </div>

          <div className="flex flex-wrap items-center gap-1.5">
            {["admin", "staff", "worker", "customer"].map((r) => (
              <button
                key={r}
                onClick={() => {
                  setRole(r);
                  if (r === "worker" || r === "customer")
                    setActiveTab("inventory");
                }}
                className={`px-3 py-1 rounded-full text-xs font-semibold capitalize ${
                  role === r
                    ? "bg-blue-600 text-white"
                    : "bg-slate-200 text-slate-700"
                }`}
              >
                {r}
              </button>
            ))}
          </div>
        </div>

        {/* Summary Cards */}
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
          <div className="bg-white p-4 rounded-xl shadow-sm border-l-4 border-blue-600">
            <p className="text-xs text-slate-500">Total Products</p>
            <p className="text-2xl font-bold text-slate-800">
              {products.length} Items
            </p>
          </div>

          {role !== "worker" && (
            <div className="bg-white p-4 rounded-xl shadow-sm border-l-4 border-emerald-600">
              <p className="text-xs text-slate-500">
                {activeTab === "expenses"
                  ? "Total Office Expenses"
                  : "Total Stock Value"}
              </p>
              <p className="text-2xl font-bold text-slate-800">
                Rs.{" "}
                {(activeTab === "expenses"
                  ? totalExpenses
                  : totalStockValue
                ).toLocaleString()}
              </p>
            </div>
          )}

          <div className="bg-white p-4 rounded-xl shadow-sm border-l-4 border-amber-500 flex items-center justify-between">
            <div>
              <p className="text-xs text-slate-500">PDF Report</p>
              <p className="text-sm font-bold text-slate-700">1-Click Export</p>
            </div>
            <button
              onClick={downloadPDF}
              className="flex items-center gap-2 bg-slate-900 text-white px-4 py-2 rounded-lg text-xs font-semibold"
            >
              <Download size={15} /> Download PDF
            </button>
          </div>
        </div>

        {/* INVENTORY TAB */}
        {activeTab === "inventory" && (
          <div className="space-y-6">
            {/* Add New Product Form (Admin & Staff Only) */}
            {(role === "admin" || role === "staff") && (
              <form
                onSubmit={handleAddProduct}
                className="bg-white p-4 rounded-xl shadow-sm grid grid-cols-2 sm:grid-cols-6 gap-3"
              >
                <input
                  type="text"
                  placeholder="Item Name *"
                  required
                  value={newItem.name}
                  onChange={(e) =>
                    setNewItem({ ...newItem, name: e.target.value })
                  }
                  className="col-span-2 border rounded-lg px-3 py-2 text-sm"
                />
                <input
                  type="text"
                  placeholder="SKU Code"
                  value={newItem.sku}
                  onChange={(e) =>
                    setNewItem({ ...newItem, sku: e.target.value })
                  }
                  className="border rounded-lg px-3 py-2 text-sm"
                />
                <input
                  type="number"
                  placeholder="Sale Price"
                  value={newItem.sale_price}
                  onChange={(e) =>
                    setNewItem({ ...newItem, sale_price: e.target.value })
                  }
                  className="border rounded-lg px-3 py-2 text-sm"
                />
                <input
                  type="number"
                  placeholder="Opening Stock"
                  value={newItem.current_stock}
                  onChange={(e) =>
                    setNewItem({ ...newItem, current_stock: e.target.value })
                  }
                  className="border rounded-lg px-3 py-2 text-sm"
                />
                <button
                  type="submit"
                  className="col-span-2 sm:col-span-1 bg-blue-600 text-white rounded-lg px-4 py-2 text-sm font-semibold flex items-center justify-center gap-1"
                >
                  <Plus size={16} /> Add Item
                </button>
              </form>
            )}

            {/* Products Table */}
            <div className="bg-white rounded-xl shadow-sm overflow-hidden">
              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse">
                  <thead>
                    <tr className="bg-slate-50 text-slate-600 text-xs uppercase">
                      <th className="p-4">Item</th>
                      <th className="p-4">Stock</th>
                      {role !== "worker" && <th className="p-4">Price</th>}
                      {role !== "customer" && (
                        <th className="p-4 text-right">Stock Action</th>
                      )}
                    </tr>
                  </thead>
                  <tbody className="divide-y text-sm">
                    {products.length === 0 ? (
                      <tr>
                        <td
                          colSpan="4"
                          className="p-6 text-center text-slate-400"
                        >
                          Abhi koi item add nahi hua. Upar form se pehla item
                          add karein!
                        </td>
                      </tr>
                    ) : (
                      products.map((item) => (
                        <tr key={item.id}>
                          <td className="p-4 font-medium text-slate-800">
                            {item.name}
                            <span className="block text-xs text-slate-400">
                              {item.sku}
                            </span>
                          </td>
                          <td className="p-4">
                            <span
                              className={`px-2.5 py-1 rounded-full text-xs font-semibold ${
                                item.current_stock <= (item.min_stock_alert || 5)
                                  ? "bg-red-100 text-red-700"
                                  : "bg-emerald-100 text-emerald-700"
                              }`}
                            >
                              {item.current_stock} Units
                            </span>
                          </td>
                          {role !== "worker" && (
                            <td className="p-4 font-semibold">
                              Rs. {item.sale_price}
                            </td>
                          )}
                          {role !== "customer" && (
                            <td className="p-4 text-right space-x-2">
                              <button
                                onClick={() => handleUpdateStock(item, 1)}
                                className="bg-emerald-600 text-white px-2.5 py-1 rounded text-xs font-bold"
                              >
                                + IN
                              </button>
                              <button
                                onClick={() => handleUpdateStock(item, -1)}
                                className="bg-rose-600 text-white px-2.5 py-1 rounded text-xs font-bold"
                              >
                                - OUT
                              </button>
                            </td>
                          )}
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        {/* EXPENSES TAB (Admin & Staff) */}
        {activeTab === "expenses" && (role === "admin" || role === "staff") && (
          <div className="space-y-6">
            <form
              onSubmit={handleAddExpense}
              className="bg-white p-4 rounded-xl shadow-sm grid grid-cols-1 sm:grid-cols-4 gap-3"
            >
              <input
                type="text"
                placeholder="Expense Detail (e.g. Bijli Bill, Chai) *"
                required
                value={newExpense.title}
                onChange={(e) =>
                  setNewExpense({ ...newExpense, title: e.target.value })
                }
                className="sm:col-span-2 border rounded-lg px-3 py-2 text-sm"
              />
              <input
                type="number"
                placeholder="Amount (Rs.) *"
                required
                value={newExpense.amount}
                onChange={(e) =>
                  setNewExpense({ ...newExpense, amount: e.target.value })
                }
                className="border rounded-lg px-3 py-2 text-sm"
              />
              <button
                type="submit"
                className="bg-blue-600 text-white rounded-lg px-4 py-2 text-sm font-semibold"
              >
                + Save Expense
              </button>
            </form>

            <div className="bg-white rounded-xl shadow-sm overflow-hidden">
              <table className="w-full text-left border-collapse">
                <thead>
                  <tr className="bg-slate-50 text-slate-600 text-xs uppercase">
                    <th className="p-4">Date</th>
                    <th className="p-4">Detail</th>
                    <th className="p-4 text-right">Amount</th>
                  </tr>
                </thead>
                <tbody className="divide-y text-sm">
                  {expenses.map((ex) => (
                    <tr key={ex.id}>
                      <td className="p-4 text-slate-500">{ex.expense_date}</td>
                      <td className="p-4 font-medium">{ex.title}</td>
                      <td className="p-4 text-right font-bold text-rose-600">
                        Rs. {ex.amount}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </main>

      {/* Mobile Bottom Navigation */}
      <nav className="md:hidden fixed bottom-0 left-0 right-0 bg-slate-900 text-white flex justify-around py-3 border-t border-slate-700">
        <button
          onClick={() => setActiveTab("inventory")}
          className={`flex flex-col items-center text-xs ${
            activeTab === "inventory" ? "text-blue-400" : "text-slate-300"
          }`}
        >
          <Package size={20} /> Stock
        </button>

        {(role === "admin" || role === "staff") && (
          <button
            onClick={() => setActiveTab("expenses")}
            className={`flex flex-col items-center text-xs ${
              activeTab === "expenses" ? "text-blue-400" : "text-slate-300"
            }`}
          >
            <Wallet size={20} /> Expenses
          </button>
        )}

        <button
          onClick={downloadPDF}
          className="flex flex-col items-center text-xs text-slate-300"
        >
          <FileText size={20} /> PDF Report
        </button>
      </nav>
    </div>
  );
}
